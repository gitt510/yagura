# README demo, regenerated by `just screenshot` (requires vhs).
# The repos are synthetic (docs/fixture.sh) and live under a throwaway HOME,
# so the recording is reproducible and shows no real paths.
Output docs/demo.gif

Set Shell bash
Set FontSize 14
Set Width 900
Set Height 520
Set Padding 12
Set Theme "Catppuccin Mocha"

Hide
Type `DEMO_HOME=$(mktemp -d) && bash docs/fixture.sh "$DEMO_HOME"`
Enter
Type `mkdir -p "$DEMO_HOME/bin" && go build -o "$DEMO_HOME/bin/yagura" .`
Enter
Sleep 20s
Type `export PATH="$DEMO_HOME/bin:$PATH" HOME="$DEMO_HOME" && clear`
Enter
Show

Type "yagura --root ~/ghq/github.com/acme"
Sleep 500ms
Enter
Sleep 3.5s
Type "j"
Sleep 600ms
Type "j"
Sleep 1.2s
Tab
Sleep 3.5s
Tab
Sleep 3s
